# ─────────────────────────────────────────────────────────────────────────────
# SHOPIFY
# ─────────────────────────────────────────────────────────────────────────────

# Your myshopify.com domain (e.g. my-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=

# CDN base URL for customer-uploaded files (used as fallback when tile not in imagegen DB)
# Found in any Shopify CDN URL: https://cdn.shopify.com/s/files/1/XXXX/XXXX/XXXX/files
SHOPIFY_CDN_FILES_BASE_URL=

# Shopify Admin API access token (starts with shpat_)
# Create in: Shopify Admin → Settings → Apps → Develop apps → Create an app
# Scopes needed: read_orders, read_products, read_customers, read_analytics
SHOPIFY_ADMIN_API_TOKEN=

# Shopify API version to use (keep pinned, update deliberately)
SHOPIFY_API_VERSION=2024-04

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — NEVER expose in browser, server-side only
# Used by cron jobs and admin scripts to bypass row-level security
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SLACK
# ─────────────────────────────────────────────────────────────────────────────

# Bot OAuth token (starts with xoxb-)
# Create a Slack app at api.slack.com/apps, add OAuth scopes:
#   chat:write, files:write, channels:read
SLACK_BOT_TOKEN=

# Channel ID where the daily report will be posted (not the channel name)
# Right-click a channel in Slack → Copy link — the ID is the last segment
SLACK_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# CRON / SECURITY
# ─────────────────────────────────────────────────────────────────────────────

# Secret token to authenticate Vercel Cron requests to your API routes
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# SCHEDULING
# ─────────────────────────────────────────────────────────────────────────────

# IANA timezone for your store (e.g. America/New_York, America/Los_Angeles)
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
STORE_TIMEZONE=America/New_York

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" to skip posting to Slack and writing to Supabase (for testing)
DRY_RUN=false

# ─────────────────────────────────────────────────────────────────────────────
# VERCEL (set automatically in Vercel deployments, needed locally for preview)
# ─────────────────────────────────────────────────────────────────────────────

# Full public URL of this deployment (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# META (FACEBOOK) ADS
# ─────────────────────────────────────────────────────────────────────────────

# Long-lived system user token with ads_read scope
# Business Settings → System Users → Generate New Token → select app → ads_read
META_ACCESS_TOKEN=

# Numeric ad account ID only (no "act_" prefix)
META_AD_ACCOUNT_ID=852673303845594

# Graph API version — update deliberately when Meta deprecates (check: https://developers.facebook.com/docs/graph-api/changelog)
META_API_VERSION=v21.0

# ─────────────────────────────────────────────────────────────────────────────
# GELATO MUG FULFILLMENT
# ─────────────────────────────────────────────────────────────────────────────

# Shopify webhook HMAC secret — from Admin → Settings → Notifications → Webhooks → Edit
SHOPIFY_WEBHOOK_SECRET=

# Gelato Order Flow API key (from Gelato dashboard → Developers)
GELATO_API_KEY=
# Set to "true" to use Gelato sandbox/test mode
GELATO_TEST_MODE=true
# Gelato webhook signing secret
GELATO_WEBHOOK_SECRET=

# Supabase storage bucket name for mug print PDFs (default: mug-prints)
SUPABASE_MUG_PRINTS_BUCKET=mug-prints

# imagegen Supabase project — used to resolve tile image paths
# Project URL: https://supabase.com/dashboard/project/ngyunrirwrjudbgaijek
IMAGEGEN_SUPABASE_URL=https://ngyunrirwrjudbgaijek.supabase.co
IMAGEGEN_SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the static branded half of the mug print
# Upload the "Some memories deserve a refill" image to any public storage and paste the URL here
MUG_STATIC_IMAGE_URL=
